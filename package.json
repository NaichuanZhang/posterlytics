{
  "name": "posterlytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:marketing:qrs": "node scripts/generate-marketing-qrs.mjs",
    "lint": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test --import ./tests/register.mjs tests/*.test.ts",
    "test:ui": "node tests/durableGenerationUiSmoke.mjs && node tests/assetReviewUiSmoke.mjs",
    "test:marketing": "node tests/marketingUiSmoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@insforge/sdk": "latest",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "playwright": "^1.58.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
